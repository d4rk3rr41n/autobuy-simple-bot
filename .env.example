# Configuración del Producto
PRODUCT_URL=https://www.amazon.com/-/es/gp/product/B0HJ6F8L6V/ref=ox_sc_saved_image_1?smid=ATVPDKIKX0DER&psc=1
ASIN=B0HJ6F8L6V
EXPECTED_SELLER_ID=ATVPDKIKX0DER

# Filtro de Precio Máximo (en USD). Pon 0 para desactivar el límite de precio.
MAX_PRICE=550.00
# Si es true, solo compra si el vendedor es Amazon.com oficial
STRICT_AMAZON_SELLER=true

# Tiempo base de refresco en segundos (el bot aplica jitter aleatorio de +/- 0.8s)
REFRESH_SECONDS=5

# Modo de prueba:
# true  = Hace todo el flujo pero NO presiona el botón final de pagar (ideal para probar)
# false = Ejecuta la compra real automáticamente
DRY_RUN=true

# Configuración de Telegram (Opcional pero recomendado)
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Sonido de alarma en Windows (true / false)
ENABLE_SOUND_ALARM=true
